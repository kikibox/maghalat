+/** Localize page/content entities, not the shared WebSite or Organization. */
+function navar_rank_math_page_entity_language( $data ) {
+    if ( is_admin() || ! is_array($data) || ! function_exists('navar_lang') ) return $data;
+    $languages = array('fa'=>'fa-IR', 'iraq'=>'ar-IQ', 'tj'=>'tg-TJ', 'en'=>'en-US', 'ru'=>'ru-RU');
+    $lang = navar_lang();
+    if ( ! isset($languages[$lang]) ) return $data;
+    $page_types = array('WebPage','ItemPage','AboutPage','ContactPage','CollectionPage','SearchResultsPage','FAQPage','QAPage','Article','BlogPosting','NewsArticle');
+    $wrapped = isset($data['@graph']) && is_array($data['@graph']);
+    $nodes = $wrapped ? $data['@graph'] : $data;
+    foreach ( $nodes as &$entity ) {
+        if ( ! is_array($entity) || empty($entity['@type']) ) continue;
+        if ( array_intersect((array)$entity['@type'], $page_types) ) {
+            $entity['inLanguage'] = $languages[$lang];
+        }
+    }
+    unset($entity);
+    if ( $wrapped ) $data['@graph'] = $nodes; else $data = $nodes;
+    return $data;
+}
+// Apply to the final validated graph, after Rank Math connects content entities.
+add_filter('rank_math/schema/validated_data', 'navar_rank_math_page_entity_language', PHP_INT_MAX);
